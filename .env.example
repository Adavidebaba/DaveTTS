# ============================================================
# DaveTTS — Configurazione Provider TTS
# ============================================================
# Scegli il provider TTS: "gemini" (default) o "xai"
# ============================================================

TTS_PROVIDER=gemini

# ============================================================
# Google Gemini API Key
# Crea la tua chiave su https://aistudio.google.com/apikey
# ============================================================

GEMINI_API_KEY=la-tua-chiave-gemini-qui

# ============================================================
# xAI API Key (opzionale, solo se usi provider "xai")
# Crea la tua chiave su https://console.x.ai → API Keys
# La chiave deve iniziare con "xai-"
# ============================================================

# XAI_API_KEY=xai-la-tua-chiave-qui

# Richieste parallele all'API TTS (default: 20, max consigliato: 50)
# MAX_CONCURRENT_REQUESTS=20
